# Salin file ini menjadi .env lalu sesuaikan nilainya.
#   PowerShell:  Copy-Item .env.example .env
# File .env TIDAK ikut di-commit (tercantum di .gitignore).

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Dipakai docker-compose.yml untuk container PostgreSQL & backend
POSTGRES_USER=laptopprice
POSTGRES_PASSWORD=ganti-dengan-password-anda
POSTGRES_DB=laptopprice

# Untuk menjalankan backend TANPA Docker:
# - Biarkan DATABASE_URL tidak diisi -> otomatis SQLite (file backend/laptopprice.db)
# - Atau arahkan ke PostgreSQL lokal, contoh:
# DATABASE_URL=postgresql+psycopg://laptopprice:password@localhost:5432/laptopprice
# (Di Docker, DATABASE_URL diatur otomatis oleh docker-compose.yml)

# ---------------------------------------------------------------
# Penyesuaian harga (kosongkan untuk memakai backend/data/penyesuaian_harga.json,
# yang mencantumkan sumber & tanggal datanya)
# ---------------------------------------------------------------
# KURS_EUR_IDR=20010
# FAKTOR_INFLASI=1.302

# ---------------------------------------------------------------
# Web
# ---------------------------------------------------------------
# Origin website yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Alamat API yang dipanggil browser (ditanam saat build frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
